---
import {TransformType} from "../../../../helpers/AcceleratorImagesHelper";
const {context, widgetConfig} = Astro.props;
import {StoryMainImage_getData} from "./StoryMainImageGetData";
import React from 'react';
import _ from 'lodash';
import {StoryMainImageParams, StoryMainImageResponse} from "./types";
import RingImage from "../../../common/RingImage.astro";
import {
    WidgetHelper_getWidgetCssClasses
} from "../../../../helpers/WidgetHelper";
import {
    ImageHelper_getImageMetaData,
    ImageHelper_getImageDimensionsFromObject, ImageHelper_processImage
} from "../../../../helpers/ImageHelper";
import {UtilsHelper_convertToInt} from "../../../../helpers/UtilsHelper";
import {MainImageReference} from "@ringpublishing/graphql-api-client-got/dist/types/websites-api";
import ImageMetaData from "../../../common/ImageMetaData.astro";

const response = await StoryMainImage_getData({widgetConfig, context});
const caption = _.get(response, 'data.story.image.caption', "");
const originalImageWidth = UtilsHelper_convertToInt(_.get(response, 'data.story.image.image.width', 0));
const originalImageHeight = UtilsHelper_convertToInt(_.get(response, 'data.story.image.image.height', 0));
const imageObj = _.get(response, 'data.story.image') as MainImageReference;

const processedImage = await ImageHelper_processImage({
    presetCode: _.get(imageObj, 'preset.code'),
    imageObj,
    widgetConfig,
    imageSizes: ImageHelper_getImageDimensionsFromObject(widgetConfig, context),
    context,
    originalImageWidth,
    originalImageHeight
});

---

<div class={WidgetHelper_getWidgetCssClasses('StoryMainImage', widgetConfig, context)}>
    {processedImage.url && (
            <>
                {widgetConfig.showLinkToImage ? (
                        <a href={processedImage.url} target="_blank" data-pswp-src={processedImage.url} data-pswp-width={originalImageWidth}
                           data-pswp-height={originalImageHeight}>
                            <RingImage
                                    priority={true}
                                    src={processedImage.url}
                                    alt={caption}
                                    transform={TransformType.ResizeCropAuto}
                                    width={processedImage.width}
                                    height={processedImage.height}/>
                        </a>
                ) : (
                        <RingImage
                                priority={true}
                                src={processedImage.url}
                                alt={caption}
                                transform={TransformType.ResizeCropAuto}
                                width={processedImage.width}
                                height={processedImage.height}/>
                )}
                <ImageMetaData imageMetaData={ImageHelper_getImageMetaData(imageObj)}/>
            </>
    )}
</div>
