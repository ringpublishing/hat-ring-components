---
import AdditionalComponentTemplate from "../../../common/AdditionalComponentTemplate.astro";
const {
    content,
    widgetConfig,
    context,
    extendableAttributes
} = Astro.props as StoryContentSwitcherParams;
import React from 'react';
import _ from 'lodash';
import * as BlocksTypes from "./StoryContentBlocks/index";
import {AppContext} from "../../../../types/types";
import {StoryContentWidgetConfig, StoryContentSwitcherParams} from "./types";
import {UtilsHelper_convertToInt} from "../../../../helpers/UtilsHelper";
import { AdditionalComponentHelper_insertComponentAtPattern } from "../../../../helpers/AdditionalComponentHelper";

let isGroupBlock = false;
let isIgnoredGroupBlock = false;
let groupElements: any[] = [];
const ignoredFrameBlocksNames = _.get(widgetConfig, 'ignoredFrameBlocksNames', '').split(',').map(name => name.trim());

const allBlocksTypes = (extendableAttributes ? extendableAttributes.customGroupBlocks : null) || BlocksTypes;
let toRender: boolean | JSX.Element = false;

if (!content) {
    toRender = false;
}


const displayFrom = widgetConfig.displayFrom ? UtilsHelper_convertToInt(widgetConfig.displayFrom) : null;
let displayTo = widgetConfig.displayTo ? UtilsHelper_convertToInt(widgetConfig.displayTo) : null;

function getBlockType(block) {
    const blockType = block.type ? _.upperFirst(_.camelCase(block.type)) + 'Block' : 'NotHandledBlock';
    if (blockType === 'GroupBlock' && extendableAttributes?.customGroupBlocks?.[block.name]) {
        return extendableAttributes.customGroupBlocks[block.name];
    }
    return allBlocksTypes[blockType] ? allBlocksTypes[blockType] : BlocksTypes['NotHandledBlock'];
}

function isBlockWithinDisplayRange(index) {
    if (displayFrom && displayFrom > index + 1) {
        return false;
    }
    if (displayTo && displayTo < index + 1) {
        return false;
    }

    return true;
}

function checkAndProcessGroupBlock(block) {
    if (block.type === 'groupStart') {
        isGroupBlock = true;
        if (ignoredFrameBlocksNames.includes(block.name)) {
            isIgnoredGroupBlock = true;
        }
        return true;
    } else if (block.type === 'groupEnd') {
        isGroupBlock = false;
        if (ignoredFrameBlocksNames.includes(block.name)) {
            isIgnoredGroupBlock = false;
            return true;
        }
        block.type = 'group';
        block.elements = [...groupElements];
        groupElements = [];
    }

    if (isGroupBlock) {
        if (!isIgnoredGroupBlock) {
            groupElements.push(block);
        }
        return true;
    }

    return false;
}
const processedContent = AdditionalComponentHelper_insertComponentAtPattern(content, widgetConfig, context);
---

{
    toRender ? (
        <Fragment set:html={toRender} />
    ) : (
        (() => {
            let originalBlockCount = 0;
            return processedContent.map((block, index) => {
                let _block = {...block};
                function renderBlock() {
                    if (checkAndProcessGroupBlock(_block)) {
                        return null;
                    }

                    originalBlockCount++;
                    if (!isBlockWithinDisplayRange(originalBlockCount - 1)) {
                        return null;
                    }

                    const BlockComponent = getBlockType(_block);
                    return BlockComponent ? (
                        <BlockComponent blockData={_block} widgetConfig={widgetConfig} context={context} extendableAttributes={extendableAttributes}/>
                    ) : null;
                }
                return <AdditionalComponentTemplate edge={_block} classNames={[]} defaultRender={renderBlock} context={context}/>
            });
        })()
    )
}
