---
import {
    ImageHelper_getImageDimensionsWithAspectRatio, ImageHelper_getImageMetaData
} from "../../../../../helpers/ImageHelper";
const {blockData, widgetConfig, context} = Astro.props as ImageBlockParams;
import React from "react";
import {default as RingImage} from "../../../../common/RingImage.astro";
import {ImageBlockParams} from "../types";
import {UtilsHelper_convertToInt, UtilsHelper_isMobile} from "../../../../../helpers/UtilsHelper";
import {TransformType} from "../../../../../helpers/AcceleratorImagesHelper";
import _ from "lodash";
import {ImageBlock} from "@ringpublishing/graphql-api-client-got/dist/types/websites-api";
import ImageMetaData from "../../../../common/ImageMetaData.astro";
const {title, alt, image, url, link} = blockData;
let imageWidth = image.width;
let imageHeight = image.height;

let maxImageWidth = UtilsHelper_convertToInt(widgetConfig.standardImageWidth);
let maxImageHeight = UtilsHelper_convertToInt(widgetConfig.standardImageHeight);

if (UtilsHelper_isMobile(context)) {
    maxImageWidth = UtilsHelper_convertToInt(widgetConfig.mobileImageWidth);
    maxImageHeight = UtilsHelper_convertToInt(widgetConfig.mobileImageHeight);
}

const calculatedDimensions = ImageHelper_getImageDimensionsWithAspectRatio(imageWidth, imageHeight, maxImageWidth, maxImageHeight);
imageWidth = calculatedDimensions.width;
imageHeight = calculatedDimensions.height;
---

<div class={['ImageBlock', 'alignment-' + blockData.alignment].join(' ')}>
    {
        <a class={link && link.url ? "withExternalUrl" : ""} href={link ? link.url : url} target="_blank"
           data-pswp-src={url} data-pswp-width={image.width} data-pswp-height={image.height}>
            <RingImage src={url} alt={alt || title || ''} width={imageWidth} height={imageHeight}
                       transform={TransformType.ResizeCropAuto}/>
        </a>
    }
    <ImageMetaData imageMetaData={ImageHelper_getImageMetaData(blockData as ImageBlock)}/>
</div>
