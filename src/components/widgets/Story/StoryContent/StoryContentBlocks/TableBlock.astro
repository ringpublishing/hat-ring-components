---
const {context, blockData, extendableAttributes}: TableBlockParams = Astro.props as TableBlockParams;
import {WidgetHelper_renderEmptyComponent} from "../../../../../helpers/WidgetHelper";
import {LinkReplacerHelper_replaceLinks} from '../../../../../helpers/LinkReplacerHelper';
import {AppContext} from "../../../../../types/types";
import {UtilsHelper_asyncParallelForEach} from "../../../../../helpers/UtilsHelper";

export interface TableBlockParams {
    context: AppContext;
    blockData: {
        type: string;
        rows: [
            {
                cells: [
                    {
                        alignment: string;
                        classes: string[];
                        colspan: null | number;
                        rowspan: null | number;
                        isHeader: boolean;
                        text: string;
                        link: {
                            url: string;
                        };
                    },
                ];
            },
        ] | [];
    };
    extendableAttributes?: any;
}
let toRender: boolean | JSX.Element = false;
if (!blockData) {
    toRender = WidgetHelper_renderEmptyComponent("TableBlock");
}

UtilsHelper_asyncParallelForEach(blockData.rows, async (row) => {
    await UtilsHelper_asyncParallelForEach(row.cells, async (cell) => {
        if (cell.text) {
            cell.text = await LinkReplacerHelper_replaceLinks(context, cell.text);
            if (extendableAttributes?.contentTextTransformers?.length) {
              for (const transformer of extendableAttributes.contentTextTransformers) {
                cell.text = await transformer({
                  context,
                  text: cell.text,
                  blockData,
                  blockType: blockData.type,
                });
              }
            }
        }
    });
});

const {rows} = blockData;
---

{
    toRender ? (
    <Fragment set:html={toRender}/>
        ) : (
            <table class="TableBlock">
                <tbody>
                    {rows.map((row) => (
                        <tr>
                            {row.cells.map((cell) => {
                                const allCellClasses = [
                                    cell.alignment ? `align${cell.alignment}` : null,
                                    ...cell.classes
                                ].filter(Boolean).join(" ");

                                const TableElementTag = cell.isHeader ? 'th' : 'td';
                                const TableElementText = cell.link ? (<a href={cell.link.url}>{cell.text}</a>
                                ) : (
                                    cell.text
                                )

                                return (
                                    <TableElementTag class={allCellClasses}
                                        colspan={cell.colspan ? cell.colspan : undefined}
                                        rowspan={cell.rowspan ? cell.rowspan : undefined}>
                                        {TableElementText}
                                    </TableElementTag>
                                )
                            })}
                        </tr>
                    ))}
                </tbody>
            </table>
        )
    }
