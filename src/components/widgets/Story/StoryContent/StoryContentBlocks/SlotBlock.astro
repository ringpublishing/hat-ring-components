---
import {StoryContentWidgetConfig} from "../types";
const {blockData, context, widgetConfig} = Astro.props as SlotBlockParams;
import {Term} from "@ringpublishing/graphql-api-client-got/dist/types/websites-api";
import _ from "lodash";
import * as ringSlots from "../slots/index";

let toRender: boolean | JSX.Element | string = false;
import {WidgetHelper_renderEmptyComponent} from "../../../../../helpers/WidgetHelper";


const availableSlots = Object.assign({}, ringSlots, context?.customData.slots);
if (!blockData.kind || !blockData.kind.code) {
    toRender = WidgetHelper_renderEmptyComponent('SlotBlock', 'SlotBlock: blockData.kind.code is missing', false);
}
const slotName = _.upperFirst(_.camelCase(blockData.kind.code));
const Component = availableSlots[slotName];
if (!Component) {
    toRender = WidgetHelper_renderEmptyComponent('SlotBlock', `SlotBlock: ${slotName} is not available in the context`, false);
}
export interface SlotBlockParams {
    blockData: {
        "type": string,
        "data": any,
        "kind": Term,
        "__typename": string
    },
    context: any,
    widgetConfig: StoryContentWidgetConfig
}
---
{toRender ?
<Fragment set:html={toRender}/>
    :
<div class="SlotBlock">
    {Component &&
            <Component blockData={blockData} context={context} widgetConfig={widgetConfig}/>}
</div>
    }
