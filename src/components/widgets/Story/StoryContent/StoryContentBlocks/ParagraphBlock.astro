---
const { context, blockData, extendableAttributes }: ParagraphBlockParams = Astro.props as ParagraphBlockParams;
import { WidgetHelper_renderEmptyComponent } from "../../../../../helpers/WidgetHelper";
import {LinkReplacerHelper_replaceLinks} from '../../../../../helpers/LinkReplacerHelper';
import { SeoLinkWhitelistHelper_processLinks } from "../../../../../helpers/seo/SeoLinkWhitelistHelper";
import { AppContext } from "../../../../../types/types";
import { StoryContentExtendableAttributes } from "../types";

export interface ParagraphBlockParams {
  context: AppContext;
  blockData: {
    type: string;
    text: string;
  };
  extendableAttributes?: StoryContentExtendableAttributes;
}
let toRender: boolean | JSX.Element | string = false;
if (!blockData) {
  toRender = WidgetHelper_renderEmptyComponent("ParagraphBlock");
}

blockData.text = await LinkReplacerHelper_replaceLinks(context, blockData.text);
if (extendableAttributes?.contentTextTransformers?.length) {
  for (const transformer of extendableAttributes.contentTextTransformers) {
    blockData.text = await transformer({
      context,
      text: blockData.text,
      blockData,
      blockType: blockData.type,
    });
  }
}
blockData.text = await SeoLinkWhitelistHelper_processLinks(context, blockData.text);
---

{
  toRender ? (
    <Fragment set:html={toRender} />
  ) : (
    <div class="ParagraphBlock">
      <p set:html={blockData.text} />
    </div>
  )
}
