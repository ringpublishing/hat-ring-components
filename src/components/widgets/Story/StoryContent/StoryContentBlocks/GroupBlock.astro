---
const {blockData, widgetConfig, context, extendableAttributes} = Astro.props;
import {default as StoryContentSwitcher} from "../StoryContentSwitcher.astro";
import {AppContext} from "../../../../../types/types";

export interface GroupBlockParams {
    name: string;
    type: string;
    alignment: string;
    elements: any[];
    widgetConfig: {
        width: number;
        height: number;
    }
    context: AppContext;
    extendableAttributes?: any;
}
---

<section class={`GroupBlock align${blockData.alignment} ${blockData.name}`}>
    <StoryContentSwitcher content={blockData.elements} widgetConfig={widgetConfig} context={context} extendableAttributes={extendableAttributes}/>
</section>
