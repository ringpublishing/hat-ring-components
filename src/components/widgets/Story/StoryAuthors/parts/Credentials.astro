---
import {StoryAuthorsWidgetConfig} from "../types";
const {context, widgetConfig, author} = Astro.props as {
    context: AppContext,
    widgetConfig: StoryAuthorsWidgetConfig,
    author: Author
};
import {Author} from "@ringpublishing/graphql-api-client-got/dist/types/websites-api";
import _ from "lodash";
import {AppContext} from "../../../../../types/types";
import {WidgetHelper_getWidgetCssClasses, WidgetHelper_renderEmptyComponent} from "../../../../../helpers/WidgetHelper";
import {TranslationProvider} from "../../../../../providers/TranslationProvider";

let toRender: boolean | JSX.Element | string = false;

const credentials = _.get(author, 'credentials', []);
if(!credentials || !Array.isArray(credentials) || credentials.length === 0) {
    toRender = WidgetHelper_renderEmptyComponent('Credentials');
}
---

{toRender ?
<Fragment set:html={toRender}/>
    :

<div class={['Credentials'].join(' ')}>
    <h2>{TranslationProvider.translate(context, 'Credentials')}</h2>
    {credentials.map((credential) => {
        return (
            <div class="credential">
                <div class="year">{credential.issueTime ? credential.issueTime.split('-').shift(): '' }</div>
                <div class="name">{_.get(credential, 'name', '')}</div>
                <div class="role">{TranslationProvider.translate(context, credential?.role?.name)}</div>
                <div class="issuer">
                    {credential?.url ?
                        <a href={credential.url} target="_blank" rel="noopener noreferrer">
                            {_.get(credential, 'issuer', '')}
                        </a>
                        :
                        _.get(credential, 'issuer', '')
                    }
                </div>


            </div>
        );
    })}
</div>
    }


