---
import _ from "lodash";
const {itemIndex, context, widgetConfig, data,} = Astro.props;
import React, {ReactElement} from 'react';
import {AppContext} from "../../../../../types/types";
import {BasicWidgetConfig, BasicWidgetResponseNode} from "../types";
import {default as RingImage} from "../../../../common/RingImage.astro";
import {
    WidgetHelper_getAppropriateTeaserImage,
    WidgetHelper_renderEmptyComponent,
} from "../../../../../helpers/WidgetHelper";
import gql from "graphql-tag";
import {
    ImageHelper_getImageDimensionsFromObject,
    ImageHelper_getImageDimensionsWithAspectRatio
} from "../../../../../helpers/ImageHelper";
import {TransformType} from "../../../../../helpers/AcceleratorImagesHelper";
import {UtilsHelper_convertToInt, UtilsHelper_isMobile} from "../../../../../helpers/UtilsHelper";

export const getFragment = () => {
    return {
        query: gql`fragment BasicWidgetImageSectionFragment on SectionItem {
            image {
                url
                caption
                preset { code }
                image {
                    url
                    width
                    height
                    presets { url role { code } }
                }
            }
            leads {
                role { code }
                image { 
                    url
                    preset { code }
                    image { presets { url role { code } } }
                }
            }
            originalContent {
                ... on Story {
                    image {
                        url
                        caption
                        preset { code }
                        crop { width height x y }
                        image {
                            url
                            width
                            height
                        }
                    }
                }
            }
        }`
    }
}
let toRender: boolean | string | JSX.Element = false;

const image = data.image || data.originalContent?.image;
let customTeaserImageUrl: string | null = null;

if (!image || !image.url) {
    toRender = WidgetHelper_renderEmptyComponent('Image');
}

const isBig = widgetConfig.countBig ? itemIndex < widgetConfig.countBig : false;
const sizes = isBig
    ? ImageHelper_getImageDimensionsFromObject(widgetConfig, context, 'bigImageSize', 'bigImageSizeMobile', '0x0')
    : ImageHelper_getImageDimensionsFromObject(widgetConfig, context, 'standardImageSize', 'standardImageSizeMobile', '0x0');

const preloadCount = UtilsHelper_isMobile(context) ? (Number(widgetConfig?.mobilePreloadImagesCount) || 0) : (Number(widgetConfig?.preloadImagesCount) || 0);
const isPriority = (preloadCount >= itemIndex + 1) || false;
const imageResizeCropMode = _.get(widgetConfig, 'imageResizeCropMode', 'cover');
const croppedSrc = _.get(data, 'image.url');
const originalSrc = _.get(data, 'originalContent.image.image.url');
const imgSrc = widgetConfig?.useOriginalImage ? originalSrc : croppedSrc;
const originalImageWidth = UtilsHelper_convertToInt(_.get(data, 'originalContent.image.image.width', 0));
const originalImageHeight = UtilsHelper_convertToInt(_.get(data, 'originalContent.image.image.height', 0));
let imageWidth = originalImageWidth;
let imageHeight = originalImageHeight;

if (widgetConfig.section_name || widgetConfig.sectionGroup) {
    customTeaserImageUrl = await WidgetHelper_getAppropriateTeaserImage(widgetConfig, context, data.leads || [], isBig);
}

if (imageResizeCropMode === 'contain' && imageWidth !== 0 && imageHeight !== 0) {
    const calculatedDimensions = ImageHelper_getImageDimensionsWithAspectRatio(imageWidth, imageHeight, sizes.width, sizes.height);
    imageWidth = calculatedDimensions.width;
    imageHeight = calculatedDimensions.height;
} else {
    imageWidth = sizes.width;
    imageHeight = sizes.height;
}

const ringImageProps = toRender ? null : {
    src: customTeaserImageUrl || imgSrc,
    alt: image.caption || data.title || '',
    transform: TransformType.ResizeCropAuto,
    width: imageWidth,
    height: imageHeight,
    priority: isPriority
};
---

{toRender ? <Fragment set:html={toRender}/> :
<div class={['Image', isBig ? 'bigImage' : ''].join(' ')}>
    <RingImage {...ringImageProps}/>
</div>
    }
