---
import {
    ImageHelper_getImageDimensionsFromObject, ImageHelper_processImage
} from "../../../../../helpers/ImageHelper";
const {itemIndex, context, widgetConfig, data} = Astro.props;
import React from 'react';
import {default as RingImage} from "../../../../common/RingImage.astro";
import {
    WidgetHelper_getAppropriateTeaserCode,
    WidgetHelper_renderEmptyComponent
} from "../../../../../helpers/WidgetHelper";
import gql from "graphql-tag";
import {GenericListResponseNode, GenericListWidgetConfig} from "../types";
import {ConfigHelper_getGeneralConfig} from "../../../../../helpers/ConfigHelper";
import {UtilsHelper_convertToInt, UtilsHelper_isMobile} from "../../../../../helpers/UtilsHelper";
import {TransformType} from "../../../../../helpers/AcceleratorImagesHelper";
import _ from "lodash";

let toRender: JSX.Element | string | null = null;
let image = data?.image;

if (!image || !image.url) {
    const generalConfig = await ConfigHelper_getGeneralConfig(context);
    if (generalConfig && generalConfig.defaultImage) {
        // @ts-ignore
        image = {
            url: generalConfig.defaultImage as string
        }
    } else {
        toRender = WidgetHelper_renderEmptyComponent('Image');
    }
}

const isMobile = UtilsHelper_isMobile(context);
const preloadCount = isMobile ? (Number(widgetConfig?.mobilePreloadImagesCount) || 0) : (Number(widgetConfig?.preloadImagesCount) || 0);
const isPriority = (preloadCount >= itemIndex + 1) || false;

const originalImageWidth = UtilsHelper_convertToInt(_.get(data, 'image.image.width', 0));
const originalImageHeight = UtilsHelper_convertToInt(_.get(data, 'image.image.height', 0));

const processedImage = await ImageHelper_processImage({
    presetCode: await WidgetHelper_getAppropriateTeaserCode(widgetConfig, context),
    context,
    widgetConfig,
    imageSizes: ImageHelper_getImageDimensionsFromObject(widgetConfig, context, "imageSize", "imageSizeMobile", '400x300'),
    imageObj: image,
    originalImageHeight,
    originalImageWidth,
    leads: data?.leads || []
})

const ringImageProps = {
    src: processedImage.url,
    alt: (image && image.caption) || data?.title || '',
    width: processedImage.width,
    height: processedImage.height,
    priority: isPriority
};

export const getFragment = () => {
    return {
        query: gql`fragment GenericListImageStoryFragment on Story {
            leads {
                role {
                    code
                }
                image {
                    url
                    crop {
                        width,
                        height,
                        y,
                        x,
                    }
                }
            }
            image {
                url
                caption
                image {
                    url
                    width
                    height
                    presets {
                        url
                        role {
                            code
                        }
                    }
                }
                preset {
                    code
                }
            }
        }`
    }
}
---

{toRender ? <Fragment set:html={toRender}/> :
    <div class={['Image'].join(' ')}>
        <RingImage {...ringImageProps} transform={TransformType.ResizeCropAuto}/>
    </div>
}

