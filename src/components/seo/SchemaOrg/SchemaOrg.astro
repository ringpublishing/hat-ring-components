---
import {Author_getData} from "../../../helpers/AuthorsHelper";
import {UtilsHelper_getCurrentUrl, UtilsHelper_slugify} from "../../../helpers/UtilsHelper";
const {context} = Astro.props as { context: AppContext };
import React from "react"
import {BreadcrumbList, ListItem, NewsArticle, Organization, Person, Thing, WithContext} from 'schema-dts';
import {AppContext, SiteContentType} from "../../../types/types";
import {
    SeoHelper_getContactNumber,
    SeoHelper_currentDescription,
    SeoHelper_getServiceLogo,
    SeoHelper_currentSiteName, SeoHelper_isSeoHomepage, SeoHelper_currentTitle
} from "../../../helpers/seo/SeoHelper";
import {gql} from "graphql-tag";
import {WebsiteApiProvider} from "../../../providers/WebsiteApiProvider";
import _ from "lodash";
import {
    ConfigHelper_currentUrl,
    ConfigHelper_getHomepageUrl,
    ConfigHelper_getSeoGeneralConfig
} from "../../../helpers/ConfigHelper";
import {Author} from "@ringpublishing/graphql-api-client-got/dist/types/websites-api";

import {Breadcrumb} from "../../widgets/common/Breadcrumbs/types";
const isHomePage = await SeoHelper_isSeoHomepage(context);
const isArticle = context.siteContentType === SiteContentType.Story;


export async function getOrganizationSchema(context): Promise<WithContext<Organization>> {
    return {
        "@context": "https://schema.org",
        "@type": "Organization",
        "@id": `${await ConfigHelper_getHomepageUrl(context)}/#organization`,
        "name": await SeoHelper_currentSiteName(context),
        "url": await ConfigHelper_getHomepageUrl(context),
        "logo": await SeoHelper_getServiceLogo(context),
        "description": await SeoHelper_currentDescription(context, 'default'),
        // "sameAs": [], // social media list
        "contactPoint": {
            "@type": "ContactPoint",
            "telephone": await SeoHelper_getContactNumber(context),
            "contactType": "Customer Service"
        }
    };
}

export async function getBreadcrumbListSchema(context: AppContext): Promise<WithContext<BreadcrumbList>> {
    const breadcrumbs: Breadcrumb[] = _.get(
        _.get(context, "hatControllerParams.gqlResponse"),
        "data.site.data.node.breadcrumbs"
    , []);
    const itemListElement: ListItem[] = [];

    breadcrumbs.forEach((breadcrumb, index) => {
        const name = index === 0 ? "Home" : breadcrumb.name;

        itemListElement.push({
            "@type": "ListItem",
            "position": index + 1,
            "name": name,
            "item": breadcrumb.url
        });
    })

    if ([SiteContentType.Story, SiteContentType.Author, SiteContentType.Topic, SiteContentType.Source].includes(context.siteContentType as SiteContentType)) {
        itemListElement.push({
            "@type": "ListItem",
            "position": itemListElement.length + 1,
            "name": await SeoHelper_currentTitle(context, 'meta-title'),
            "item": await ConfigHelper_currentUrl(context),
        })
    }

    return {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": itemListElement
    };
}

export async function getNewsArticleSchema(context: AppContext): Promise<WithContext<NewsArticle>> {
    const homepageUrl = await ConfigHelper_getHomepageUrl(context);
    const articleUrl = await ConfigHelper_currentUrl(context);

    const query = gql`
        query($storyId: UUID){
            story(id:$storyId){
                title
                date {
                    creationTime
                    modificationTime
                }
                image {
                    url
                }
                authors {
                    author {
                        name
                    }
                }
                topics(kind:"tag") {
                    topic {
                        name
                    }
                }
                content {
                    blocks {
                        ...on ParagraphBlock {
                            text
                        }
                    }
                }
            }
        }
    `;

    const variables = {
        storyId: context.id,
    };

    const response = await WebsiteApiProvider.call(query, variables);
    const authors = _.get(response, 'data.story.authors', []).map(authorObj => {
        return {
            "@type": "Person",
            "name": authorObj.author.name
        }
    });

    if (authors.length <= 0) {
        const seoGeneralConfig = await ConfigHelper_getSeoGeneralConfig(context);
        if (seoGeneralConfig.defaultArticleAuthor) {
            const defaultAuthor:{name:string, email?: string} = {
                name: seoGeneralConfig.defaultArticleAuthor
            };

            if (seoGeneralConfig.defaultArticleAuthorEmail) {
                defaultAuthor.email = seoGeneralConfig.defaultArticleAuthorEmail;
            }
        }
    }


    const dateModified = _.get(response, 'data.story.date.modificationTime') || _.get(response, 'data.story.date.creationTime');
    const datePublished = _.get(response, 'data.story.date.creationTime');
    const tagNames = _.get(response, 'data.story.topics', []).map((topicObj) => {
        return topicObj.topic.name
    })

    return {
        "@context": "https://schema.org",
        "@type": "NewsArticle",
        "@id": `${articleUrl}#article`,
        "mainEntityOfPage": {
            "@type": "WebPage",
            "@id": `${articleUrl}`,
            "primaryImageOfPage": {
                "@id": `${articleUrl}#mainPhoto`
            },
        },
        "headline": _.get(response, 'data.story.title', ''),
        "image": [_.get(response, 'data.story.image.url', '')],
        "datePublished": datePublished,
        "dateModified": dateModified,
        "author": authors.length <= 0 ? null : authors,
        "publisher": {
            "@type": "Organization",
            "name": await SeoHelper_currentSiteName(context),
            "logo": {
                "@type": "ImageObject",
                "url": await SeoHelper_getServiceLogo(context),
            }
        },
        "keywords": tagNames,
        "description": _.get(_.get(response, 'data.story.content[0].blocks', []).filter(block => block.text), '[0].text', ''),
        "isAccessibleForFree": true
    }
}

export async function getPersonSchema(context): Promise<WithContext<Person> | null>  {

    const response = await Author_getData(context,{cacheTTL: 60});

    const author = response?.data?.author;

    if(!author) {
        return null;
    }

    const homepageUrl = await ConfigHelper_getHomepageUrl(context);
    const organizationName = author.publisher?.name;
    return {
        "@context": "https://schema.org",
        "@type": "Person",
        "@id": `${homepageUrl}/#Person/${UtilsHelper_slugify(author.name)}`,
        "name": author.name,
        "url": author.publicationPoint?.url,
        "image": author.image?.image?.url || '',
        "gender": author.gender?.name,
        "jobTitle": author.occupation?.position || '',
        "description": `${author.name} is a|the ${author.occupation?.position || ''} at ${organizationName}.`,
        "worksFor": organizationName ? {
            "@type": "NewsMediaOrganization",
            "@id": `${homepageUrl}/#Organization/${UtilsHelper_slugify(organizationName)}`,
            "name": organizationName,
        }: undefined,
        "hasCredential": author.credentials?.map(credential => {
            return {
                "@type": "EducationalOccupationalCredential",
                "credentialCategory": credential.role.name,
                "name": credential.name,
                "recognizedBy": {
                    "@type": "Organization",
                    "name": credential.issuer || '',
                    "url": credential.url || ''
                }
            }
        }) || [],
        "award": author.awards?.map(award => {
            return `${award.name},${award.issuer},${award.issueTime ? award.issueTime.split('-').shift(): '' }`;
        }) || [],
        "sameAs": author.socialMedia?.map(social => {
            return social.url;
        }) || [],
        "knowsAbout": author.topics?.map(topic => {
            return topic.topic.name;
        }) || [],
        "memberOf": author.associations?.map(association => {
            return {
                "@type": "Organization",
                "@id": `${homepageUrl}/#Organization/${UtilsHelper_slugify(association.name)}`,
                "name": association.name,

            }
        }) || [],

    };
}

const organizationSchema = isHomePage && await getOrganizationSchema(context);
const breadcrumbListSchema = !isHomePage && await getBreadcrumbListSchema(context);
const newsArticleSchema = isArticle && await getNewsArticleSchema(context);
const personSchema = context.siteContentType === SiteContentType.Author && await getPersonSchema(context);

---

{organizationSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />}
{breadcrumbListSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbListSchema)} />}
{newsArticleSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(newsArticleSchema)} />}
{personSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />}
