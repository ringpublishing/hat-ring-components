---
export interface Props {
    match: string;
    pageUrl: string;
    totalKeysText: string;
}

const {match, pageUrl, totalKeysText} = Astro.props;
const podName = process.env.HOSTNAME;
---

<div>
    <div>
        {podName} pod
    </div>
    <div> status:<span id="status">in progress...</span> | cursor: <span id="cursor"></span> | {totalKeysText}: <span
            id="totalKeys"></span>
        <br>
        <button id="toggle">Pause/Resume displaying results</button>
        <button id="stop">Stop the scan</button>
    </div>
    <div id="error"></div>
    <hr>
    <div style="display: table; white-space: break-spaces; word-break:break-all; table-layout: fixed; width: 100%; max-height: 65vh; overflow-y: auto; overflow-x: auto; position: relative; content-visibility: auto; contain: layout paint; will-change: scroll; transform: translateZ(0); backface-visibility: hidden;"
         id="messages">
    </div>
</div>
<script define:vars={{match, pageUrl, podName}}>
    const statusEl = document.getElementById('status');
    const messagesEl = document.getElementById('messages');
    const cursorEl = document.getElementById('cursor');
    const totalKeysEl = document.getElementById('totalKeys');
    const errorEl = document.getElementById('error');
    let poller;
    let paused = false;

    function updateStatus(text) {
        if (statusEl) {
            statusEl.innerText = text;
        }
    }

    function handleData(data) {
        if (data.error) {
            if (errorEl) errorEl.innerHTML = `<pre>${data.error.stack}</pre>`;
            updateStatus('error');
            clearInterval(poller);
            return;
        }

        window.requestAnimationFrame(() => {
            if (cursorEl) {
                cursorEl.innerText = data.cursor;
            }
            if (totalKeysEl) {
                totalKeysEl.innerText = data.totalKeys;
            }
            if (statusEl) {
                statusEl.innerText = data.timedOut
                    ? `${data.status} (timeout after ${Math.round((data.durationMs || 0) / 1000)}s: keyspace NOT fully scanned, results are incomplete)`
                    : data.status;
            }

            if (['done', 'stopped'].includes(data.status)) {
                clearInterval(poller);
            }

            if (messagesEl && data.keys.length > 0) {
                const fragment = document.createDocumentFragment();
                const startIndex = messagesEl.children.length;
                data.keys.forEach((element, index) => {
                    const div = document.createElement('div');
                    const preQuery = document.createElement('pre');
                    preQuery.textContent = element.replaceAll('\\n', '\r\n');
                    div.appendChild(preQuery);
                    if (data?.values[element]) {
                        const preValue = document.createElement('pre');
                        preValue.textContent += JSON.stringify(data?.values[element], null, 4);
                        div.appendChild(document.createElement('hr'));
                        div.appendChild(preValue)
                    }
                    div.style.cssText = 'padding: 5px; margin: 0;';
                    if ((startIndex + index) % 2 === 1) {
                        div.style.backgroundColor = '#eaeaea';
                    }
                    fragment.appendChild(div);
                });
                messagesEl.appendChild(fragment);
            }
        });
    }

    async function poll() {
        try {
            const response = await fetch(`/${pageUrl}?match=${match}&json=1${podName ? `&pod=${podName}` : ''}`);
            if (!response.ok) {
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            const text = await response.text();
            if (text === 'Wrong pod') {
                return;
            }
            const data = JSON.parse(text);
            handleData(data);
        } catch (e) {
            console.error('Polling error:', e);
            if (errorEl) errorEl.innerText = 'Polling error. See console for details.';
            clearInterval(poller);
        }
    }

    function startPolling() {
        if (!poller) {
            poll();
            poller = setInterval(poll, 1000);
        }
    }

    function stopPolling() {
        clearInterval(poller);
        poller = null;
    }

    document.querySelector('#toggle')?.addEventListener('click', () => {
        paused = !paused;
        const isRunning = statusEl && !['done', 'stopped', 'error'].includes(statusEl.innerText);
        if (isRunning) {
            updateStatus(paused ? 'in progress... (rendering paused)' : 'in progress...');
        }
        paused ? stopPolling() : startPolling();
    });

    document.querySelector('#stop')?.addEventListener('click', async () => {
        updateStatus('stopped');
        stopPolling();

        try {
            let text;
            do {
                const response = await fetch(`/${pageUrl}?stop=1&match=${match}${podName ? `&pod=${podName}` : ''}`);
                text = await response.text();
                if (text === 'Wrong pod') {
                    await new Promise(resolve => setTimeout(resolve, 500));
                }
            } while (text === 'Wrong pod');
        } catch (e) {
            console.error('Error stopping scan:', e);
            if (errorEl) errorEl.innerText = 'Error stopping scan. See console for details.';
        }
    });

    window.onbeforeunload = () => stopPolling();

    startPolling();
</script>
